# Local development only. These values are intentionally non-secret defaults.
POSTGRES_DB=yum_review
POSTGRES_USER=yum_review
POSTGRES_PASSWORD=yum_review_local
DB_URL=jdbc:postgresql://localhost:5432/yum_review
DB_USERNAME=yum_review
DB_PASSWORD=yum_review_local
SERVER_PORT=8080
# Required only when the database has no SERVER_ADMIN account. Supply a strong
# temporary password through the process environment; never commit its value.
BOOTSTRAP_SERVER_ADMIN_EMAIL=
BOOTSTRAP_SERVER_ADMIN_PASSWORD=
# Optional. Needed only for live Naver Local place search. Never committed here.
NAVER_LOCAL_CLIENT_ID=
NAVER_LOCAL_CLIENT_SECRET=
